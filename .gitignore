# filename: .gitignore
# Code Generated by Sidekick is for learning and experimentation purposes only.

# --- Secrets & environment ---
.env                    # holds DB password — NEVER commit this

# --- Python cache & compiled files ---
__pycache__/
*.py[cod]
*.pyc

# --- Virtual environments ---
venv/
.venv/
env/

# --- IDE / editor settings ---
.vscode/
.idea/

# --- OS junk files ---
.DS_Store               # Mac
Thumbs.db               # Windows

# --- Logs ---
*.log
